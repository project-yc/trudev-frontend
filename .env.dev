# Used by `npm run build:dev` (mode=dev). Targets the dev EC2 backend.
# Empty so axios uses relative paths — Vercel rewrites /api/* to EC2.
VITE_API_BASE_URL=

# Google Sign-In — OAuth 2.0 Client ID (Web application), must match the
# backend's GOOGLE_CLIENT_ID for this environment. Not secret.
VITE_GOOGLE_CLIENT_ID=800797511409-8tlg4hqgjr0asqu4j4ug5l7hqa376ogk.apps.googleusercontent.com


VITE_POSTHOG_KEY=phc_n3xBS5UQxUY9pJ3bgu96wLCYFBRT8cvjgckZVd9U4vfX
# Defaults to https://us.i.posthog.com. Use https://eu.i.posthog.com for EU.
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Where "Book 20 minutes" goes (Calendly, Cal.com…). Unset hides the button.
VITE_TOUR_BOOKING_URL=https://cal.com/akhil-mulagada/trudev-demo

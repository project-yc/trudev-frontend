# Used by `npm run build:prod` (--mode prod).
# Leave EMPTY so axios uses relative `/api/*` paths and Vercel's rewrite
# in vercel.json proxies to the EC2 backend. Setting a value here
# bypasses the rewrite and will break the deployed app if the value
# is wrong (you'll see "Unexpected token '<'" because a parked/HTML
# page gets returned instead of JSON).
VITE_API_BASE_URL=https://dev.trudev.io

# Google Sign-In — OAuth 2.0 Client ID (Web application), must match the
# backend's GOOGLE_CLIENT_ID for this environment. Not secret.
VITE_GOOGLE_CLIENT_ID=800797511409-8tlg4hqgjr0asqu4j4ug5l7hqa376ogk.apps.googleusercontent.com


VITE_POSTHOG_KEY=phc_n3xBS5UQxUY9pJ3bgu96wLCYFBRT8cvjgckZVd9U4vfX
# Reverse proxy onto PostHog's ingestion API — us.i.posthog.com is on common
# ad-block lists, which was silently dropping events.
VITE_POSTHOG_HOST=https://r.trudev.io
# Where "Book 20 minutes" goes (Calendly, Cal.com…). Unset hides the button.
VITE_TOUR_BOOKING_URL=https://cal.com/akhil-mulagada/trudev-demo
